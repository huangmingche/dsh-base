{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-base.local/schemas/capability-pack.json",
  "title": "dsh-base capability pack",
  "description": "Shape of packs/<id>/pack.json. The runtime validator in scripts/composition/packs.mjs is authoritative (it also enforces cross-pack rules: duplicate members, dependency cycles, empty plane declarations, no-member packs). This schema documents the contract for editors and review.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "planes", "requires", "config", "toggleable", "uninstallImpact", "reuse"],
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Stable pack identity; rows never carry it, so renaming changes diagnostics only."
    },
    "planes": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "Declare only planes that have members. A declared but empty plane is rejected by the loader.",
      "properties": {
        "client": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "id"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "id": { "type": "string", "minLength": 1 },
                  "module": { "type": "string", "minLength": 1 },
                  "origin": { "type": "string", "enum": ["upstream", "custom", "fork"] },
                  "order": { "type": "number" },
                  "disabled": { "type": "boolean" },
                  "unavailableReason": { "type": "string" },
                  "replaces": { "type": "string" },
                  "documentRoutes": { "type": "array", "items": { "type": "string" } },
                  "config": { "type": "object" }
                }
              }
            ]
          }
        },
        "worker": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "think": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "requires": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Pack ids that must also be composed. Must exist and be acyclic."
    },
    "config": { "type": "object", "description": "Pack-level configuration consumed by future composition profiles." },
    "toggleable": {
      "type": "string",
      "enum": ["L1", "none"],
      "description": "L1 packs may be switched off per deployment; their client members must not appear in CLIENT_PLUGIN_POLICY.required. none is deployment-owned."
    },
    "uninstallImpact": { "type": "string", "minLength": 1 },
    "reuse": {
      "type": "object",
      "additionalProperties": true,
      "required": ["mode", "official"],
      "properties": {
        "mode": { "type": "string", "minLength": 1 },
        "official": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "reason": { "type": "string" }
      }
    }
  }
}
