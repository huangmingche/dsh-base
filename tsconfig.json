{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2024",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "allowImportingTsExtensions": true,
    "paths": {
      "@deepseek-ai/cordis": [
        "./types/cordis.d.ts"
      ],
      "@dsh-base/cloudflare-worker-http": [
        "./packages/dsh-base-cloudflare-worker-http/src/index.ts"
      ]
    }
  },
  "include": [
    "apps/web/src/**/*.ts",
    "packages/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "**/tests/**",
    "dist"
  ]
}
