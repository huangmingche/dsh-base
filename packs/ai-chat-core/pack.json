{
  "$schema": "../../scripts/composition/pack.schema.json",
  "id": "ai-chat-core",
  "planes": {
    "client": [
      "@dsh-base/client-auth-login",
      "@dsh-base/client-wire-bootstrap",
      "@dsh-base/client-session-adapter",
      "@dsh-base/client-commands",
      "@dsh-base/client-model-selection",
      "@dsh-base/client-settings",
      "@dsh-base/client-agent-preset",
      {
        "name": "@dsh-base/client-deepseek-provider",
        "module": "@dsh-base/client-deepseek-provider/client",
        "id": "client:deepseek-provider",
        "origin": "fork",
        "order": 106,
        "replaces": "@deepseek-ai/dsh-client-ui-settings-models"
      }
    ],
    "worker": [
      "@dsh-base/cloudflare-worker-agents",
      "@dsh-base/cloudflare-worker-auth",
      "@dsh-base/cloudflare-worker-http",
      "@dsh-base/cloudflare-worker-session-host",
      "@dsh-base/cloudflare-worker-session-export",
      "@dsh-base/cloudflare-worker-wire-rpc"
    ],
    "think": [
      "@dsh-base/cloudflare-think-deepseek",
      "@dsh-base/cloudflare-think-persona",
      "@dsh-base/cloudflare-think-attachments",
      "@dsh-base/cloudflare-think-subagent"
    ]
  },
  "requires": [
    "base"
  ],
  "config": {},
  "toggleable": "none",
  "uninstallImpact": "Removing the chat core removes Session creation and conversation; not individually toggleable.",
  "reuse": {
    "mode": "custom",
    "official": [],
    "reason": "Session, model and conversation core; always composed."
  }
}
