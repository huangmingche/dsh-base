{
  "name": "@dsh-base/client-open-in-app-availability",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/client/index.tsx",
    "./client": "./src/client/index.tsx",
    "./availability": "./src/availability.ts"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-open-in-app",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-ui-open-in-app": "*",
    "@deepseek-ai/dsh-client-ui-conversation": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-client-ui-renderer": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-ui-context-menu": "*",
    "react": "*",
    "zod": "*"
  },
  "dshBase": {
    "client": {
      "id": "client:open-in-app-availability",
      "origin": "custom",
      "order": 106
    },
    "reuse": {
      "mode": "seam",
      "for": [
        "@deepseek-ai/dsh-client-ui-open-in-app"
      ],
      "official": [
        "@deepseek-ai/dsh-client-ui-open-in-app"
      ],
      "reason": "RC4 contributes native opening through the Session context menus and the Files directory toolbar. The official action exposes the shared application catalog and returns null when it has no eligible target. The seam observes that catalog and provides a disabled menu action and the original compact OpenTargetButton with a localized reason. The stable client entry only exports types for the directory control. The original plugin owns all eligible launches.",
      "sourceEntries": [
        "@deepseek-ai/dsh-client-ui-open-in-app/src/client/OpenInAppAction.tsx",
        "@deepseek-ai/dsh-client-ui-open-in-app/src/client/OpenTargetButton.tsx",
        "@deepseek-ai/dsh-client-ui-open-in-app/src/client/applications.ts",
        "@deepseek-ai/dsh-client-ui-open-in-app/src/client/controller.ts",
        "@deepseek-ai/dsh-client-ui-open-in-app/src/client/locales.ts"
      ],
      "sourceReviewCommit": "9c2670d3bce5275e0d1610272958121af87787bb",
      "gaps": [
        "The official menus and Files toolbar omit native opening without an eligible application. Workers adds a disabled entry at the original position. The Files action is scoped to its workspace directory and appears only after the application catalog has settled."
      ]
    }
  }
}
