      "platform": "web"
    }
  },
  "dshBase": {
    "client": {
      "id": "client:permission-availability",
      "origin": "custom",
      "order": 70,
      "disabled": true,
      "unavailableReason": "Retired compatibility wrapper: the deployed Host now enforces per-session policies, so the unchanged official permission plugin is mounted."
