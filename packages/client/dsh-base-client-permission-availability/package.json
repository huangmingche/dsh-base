        "@deepseek-ai/dsh-client-ui-permission-presets/src/client/PermissionSelect.tsx",
        "@deepseek-ai/dsh-client-ui-permission-presets/src/client/PermissionRow.tsx",
        "@deepseek-ai/dsh-client-ui-permission-presets/src/client/locales.ts"
      ],
      "gaps": [],
      "for": [
        "@deepseek-ai/dsh-client-ui-permission-presets"
      ],
      "sourceReviewCommit": "66491b05e3f05ad35bcdd4f6cd7ed26041d9e3db"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-ui-permission-presets": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-ui-renderer": "*",
    "react": "*",
    "zod": "*"
  }
