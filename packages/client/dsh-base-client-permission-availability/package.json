{
  "name": "@dsh-base/client-permission-availability",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/client/index.tsx",
    "./client": "./src/client/index.tsx",
    "./availability": "./src/availability.ts"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
